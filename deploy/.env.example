# ===== LLM Relay 部署配置 =====
# 复制为 .env 后按需修改；install.sh 会自动生成随机密码。

# --- 服务端口 ---
# 默认只监听本机：管理接口没有登录鉴权，绑 0.0.0.0 会把渠道密钥与调用日志
# 暴露给整个局域网。WSL2 自带 localhost 转发，Windows 浏览器访问
# http://localhost:8888 不受影响；确需局域网访问再改成 0.0.0.0 并自行加防火墙。
BIND_ADDR=127.0.0.1
VERSION=dev

# --- 数据库（容器内部，不暴露到宿主）---
DB_USER=llmrelay
DB_PASSWORD=CHANGE_ME
DB_NAME=llm_relay

# --- 模型单价同步 ---
# 同步间隔（小时），0 或负数回退为 24
PRICING_UPDATE_INTERVAL_HOURS=24
# 是否抓取 OpenAI / DeepSeek 官方定价页（含 DeepSeek 峰谷双价）
PRICING_OFFICIAL_SYNC_ENABLED=true
# 同步走代理时填写，例如 http://127.0.0.1:8118
PRICING_PROXY_URL=

# --- 构建期代理（可选）---
# Docker Hub / GitHub 直连不通时填写，供 install.sh 配置 Docker 守护进程代理。
# 留空表示直连。格式示例：user:pass@host:1080
UPSTREAM_SOCKS=
# 格式示例：http://user:pass@host:8088
UPSTREAM_HTTP=

# --- 日志与报文留存 ---
LOG_LEVEL=info
LOG_FORMAT=text
# all=全存 errors=仅错误 none=不存
# errors 是日常最实用的档位；想在「请求日志」里回看每次调用的完整报文就设为 all，
# 注意报文含提示词原文，且会随调用量增长，配好下面的保留天数。
RELAY_PAYLOAD_STORAGE_MODE=errors
# 单条请求/响应报文留存上限（KB），超出部分截断并标注
RELAY_PAYLOAD_MAX_KB=256

TZ=Asia/Shanghai
