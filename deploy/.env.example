# ===== LLM Relay 部署配置 =====
# 复制为 .env 后按需修改；install.sh 会自动生成随机密码。

# --- 服务端口 ---
# host 网络模式下 app 进程直接监听宿主，下面两个变量就是实际的监听地址与端口。
# 本地部署默认只监听本机回环；部署到公网服务器时改 0.0.0.0 前必须先设好
# RELAY_ADMIN_KEY（登录鉴权），并建议加反向代理 + HTTPS（见 README）。
SERVER_HOST=127.0.0.1
SERVER_PORT=8888
# postgres 发布到宿主回环的端口（host 模式的 app 经它连数据库）。
# 15432 避开了宿主上已有的原生 postgres（5432）。
DB_HOST_PORT=15432
VERSION=dev

# --- 管理台登录密钥（公网部署必设）---
# 管理后台采用无账号的密钥登录：全站只有这一把密钥，浏览器打开管理台时
# 输入它换取登录会话。密钥只在启动时取哈希比对，不落库、不进配置备份。
# 未设置时登录鉴权整体关闭（旧部署行为不变），但界面会持续显示警告横幅。
# install.sh 首次安装会自动生成 48 位随机值；轮换后所有已登录会话立即失效。
RELAY_ADMIN_KEY=CHANGE_ME
# 登录会话有效期（Go duration 写法）。默认 168h（7 天），上限 720h。
# RELAY_SESSION_TTL=168h
# 可信反向代理地址列表（逗号分隔）。经 nginx/caddy 反代部署时按它采信
# X-Forwarded-For 解析真实客户端 IP（登录限流按 IP 计数）；默认只信回环，
# 覆盖「代理与本服务同机」的最常见部署。直连部署不用改。
# SERVER_TRUSTED_PROXIES=127.0.0.1,::1

# --- 密钥加密主密钥（重要）---
# 渠道里的上游密钥以 AES-GCM 加密后存库，用的就是这把主密钥。
# 留空或不设置会退回程序内置的默认值——那是公开可知的，等于没有加密：
# 任何拿到数据库或备份文件的人都能解出全部上游密钥。
# install.sh 首次安装会自动生成 48 位随机值；换机恢复时务必保持一致，
# 否则渠道密钥解不开，需要重新填写（可用 deploy/../scripts 里的轮换工具迁移）。
RELAY_SECRET=CHANGE_ME

# --- 数据库（容器内部，不暴露到宿主）---
DB_USER=llmrelay
DB_PASSWORD=CHANGE_ME
DB_NAME=llm_relay


# --- 构建期代理（可选）---
# Docker Hub / GitHub 直连不通时填写，供 install.sh 配置 Docker 守护进程代理。
# 留空表示直连。格式示例：user:pass@host:1080
UPSTREAM_SOCKS=
# 格式示例：http://user:pass@host:8088
UPSTREAM_HTTP=

# --- 日志与报文留存 ---
LOG_LEVEL=info
LOG_FORMAT=text
# all=全存 errors=仅错误 none=不存
# errors 是日常最实用的档位；想在「请求日志」里回看每次调用的完整报文就设为 all，
# 注意报文含提示词原文，且会随调用量增长，配好下面的保留天数。
RELAY_PAYLOAD_STORAGE_MODE=errors
# 单条请求/响应报文留存上限（KB），超出部分截断并标注
RELAY_PAYLOAD_MAX_KB=256

# --- 限流与并发 ---
# 同时进行的上游请求数上限（全局闸门）。超过后请求排队等待，最多等 60 秒，
# 仍拿不到名额则返回 429。0 表示不限制。
RELAY_MAX_CONCURRENCY=64
# 每个密钥默认的每分钟请求上限。0 表示默认不限；
# 单把密钥可在「密钥信息」页单独设置，设为负数表示这把密钥完全不限（便于本地压测）。
RELAY_DEFAULT_RPM=0
# 故障转移到**同一台上游**时的等待时长（Go duration 写法，如 500ms / 2s）。
#
# 两条渠道共用同一个 base_url 时（例如同一家上游配了两条渠道），「换渠道」
# 在上游看来就是同一个端点又被连打一次 —— 那是上游判定我们攻击、直接熔断的
# 形态。切到别的上游则不等：那不会给谁造成压力，白等只是让用户多等。
# 上游给了 Retry-After（429/503）时以它为准，但封顶 8 秒。
# 设为 0 表示关闭（回到「零间隔重试」的旧行为）。
RELAY_RETRY_SAME_UPSTREAM_DELAY=500ms

# 时区：进程本地时区，决定可用时段与时段倍率的判断窗口。
TZ=Asia/Shanghai
