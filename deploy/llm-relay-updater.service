[Unit]
Description=LLM Relay 宿主侧更新器（让容器内的管理台能够一键更新自己）
Documentation=file:///opt/llm-relay/README.md
# 必须在 docker 之后：它要执行 docker pull / docker compose。
# 但**不**依赖 llm-relay.service —— 两者的关系是反的：
# 应用需要更新器在场，而更新器不需要应用在跑（应用崩了的时候，
# 更新器恰恰是最该还能用的东西，回滚就靠它）。
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple

# 给这个服务一个运行时目录，socket 放在里面。
#
# RuntimeDirectory 由 systemd 创建（权限 0755，属主是本服务的 User），
# 服务停止时自动清理 —— 这一点很重要：unix socket 文件不会因为进程
# 退出而消失，留在原地会让下一次启动时的 bind 失败，
# 也会让客户端误判「更新器还在」。
RuntimeDirectory=llm-relay
RuntimeDirectoryMode=0755

# 两条命令之间不需要 shell：ExecStart 里已经有了完整的可执行文件路径。
#
# 这些参数的**字面值由 install.sh 写入**（它会在写完单元文件后做
# sed 替换）。systemd 不做 shell 展开 —— 它只认 $VAR / ${VAR}，
# 不认 ${VAR:-默认值} 这种写法，写上去会被原样当成参数值传进去。
# 所以这里用占位符，由安装脚本按实际部署形态填：
#
#   __INSTALL_DIR__  安装目录（默认 /opt/llm-relay）
#   __STRATEGY__     更新策略（见 install.sh 的说明）
#   __IMAGE__        镜像名（strategy=image 时用它）
#
# 为什么不在这里给默认值就完事：安装目录可以被 INSTALL_DIR 改掉，
# 镜像名取决于部署形态（本地构建的 llm-relay:local 与 GHCR 上的
# ghcr.io/ashu1800/llm-relay:latest 是两条完全不同的更新路径），
# 写死任何一组都会让另一组部署拿到一个指向不存在目标的单元。
ExecStart=__INSTALL_DIR__/llm-relay-updater \
    -socket /run/llm-relay-updater.sock \
    -compose-file __INSTALL_DIR__/deploy/docker-compose.yml \
    -service app \
    -strategy __STRATEGY__ \
    -image __IMAGE__ \
    -repo-dir __INSTALL_DIR__ \
    -repo __REPO__ \
    -health-url http://127.0.0.1:8888/readyz \
    -log-level info
# 注意这里**没有** -version-url。
#
# 早先它指向 /api/admin/system/version，用来判断「是不是已经最新」——
# 但那个接口要登录，更新器没有会话（实测 401），所以这个判断从来没生效过。
# 更根本的问题是：它靠 HTTP 去问一个**可能正躺着**的服务，而更新器最需要
# 知道版本的时刻恰恰是服务起不来的时候。
# 现在改成读镜像标签（见 deploy/Dockerfile 的 org.opencontainers.image.version），
# 完全离线、不需要凭据。
#
# 这个 flag 已经从程序里删掉了，单元里若留着它，systemd 会以
# exit-code 2（flag 解析失败）反复重启 —— 实测踩过一次。
#
# 同样没有 -rollback-tag：默认由 -image 推导为 <镜像名>:rollback，
# 需要同机跑多份部署时才显式指定。

Restart=always
RestartSec=5

# ---- 权限收窄 ----
#
# 这个进程需要以 root 跑：docker 命令要访问 /var/run/docker.sock，
# 而那个 socket 只有 root 与 docker 组能写。把它加入 docker 组是
# 等价的替代做法，但那样它会继承 docker 组的全部权限 —— 与直接 root
# 相比没有实质收益，却多了一个「组关系是否配好」的故障面。
#
# 下面的限制都是「只减不加」的：
#   NoNewPrivileges    禁止通过 setuid 提权
#   PrivateTmp         私有 /tmp（它不需要与任何人共享临时文件）
#   ProtectHome        看不到 /home（它就是不需要）
#   ProtectSystem=full 除 /usr /boot /etc 外只读……
# 但 /etc 必须可写吗？不需要，所以用 full 而不是 strict，
# 而上面 RuntimeDirectory 给的 /run/llm-relay 是可写的。
#
# 注意**没有** ProtectSystem=strict：那会让 /opt/llm-relay 也变只读，
# 而 docker compose 需要在那个目录下读写（它每次都会去读 .env、
# 并可能写 compose 的缓存）。用 full 是这里的正确取舍。
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# 日志进 journald：journalctl -u llm-relay-updater -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-relay-updater

TimeoutStartSec=0
# 升级过程中可能有 docker pull 在跑，停止时给它时间收尾，
# 而不是半途 SIGKILL 留下一个「拉到一半」的状态
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
